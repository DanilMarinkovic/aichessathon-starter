#!/usr/bin/env bash
# Download a public Stockfish training binpack.
#
#   FILE=wrongIsRight_nodes5000pv2.binpack sbatch aire/fetch-binpack.slurm
#
# The rules are explicit that this is allowed: "Training data unrestricted, including positions
# annotated by an existing engine", and "any network you ship is one you trained yourself".
# What is forbidden is starting from someone else's *network* -- "fine-tuning or re-exporting
# one counts as shipping it". We train our own architecture from random initialisation; only
# the positions come from elsewhere.
#
# Worth stating why this is worth doing at all. Our own set is 118M positions generated by our
# engine playing itself at 50k nodes and labelled at depth 10. These are on the order of a
# billion positions from Stockfish self-play, annotated at 5000 nodes with multi-PV filtering.
# tools/blindspot.py puts our network's mean error at 100cp on held-out data and 306cp where
# material misleads; that is a data problem before it is an architecture problem, and two
# attempts to fix it by regenerating our own data have failed.
#
# Downloaded to /users rather than node-local scratch on purpose: scratch is wiped when the job
# ends, and this file wants to outlive the download so training can be a separate job.

#SBATCH --job-name=fetch-binpack
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=01:30:00
#SBATCH --output=aire/logs/fetch-binpack-%j.out

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$PWD}"
mkdir -p aire/logs aire/data

REPO=${REPO:-official-stockfish/master-binpacks}
FILE=${FILE:-wrongIsRight_nodes5000pv2.binpack}
DEST=aire/data/$FILE

echo "quota before:"; quota -s | tail -1
if [ -s "$DEST" ]; then echo "$DEST already present"; exit 0; fi

URL="https://huggingface.co/datasets/$REPO/resolve/main/$FILE"
echo "fetching $URL"
# --continue-at so a job killed at the wall limit can be resubmitted rather than restarted.
curl -L --fail --continue-at - --retry 5 --retry-delay 10 -o "$DEST" "$URL"

echo
ls -la "$DEST"
echo "quota after:"; quota -s | tail -1
